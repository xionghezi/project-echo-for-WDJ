{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-echo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "none"
  },
  "vars": {
    "ADMIN_ACCESS_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-echo",
      "migrations_dir": "drizzle"
    }
  ]
}
